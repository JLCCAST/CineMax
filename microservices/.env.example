# Variables de entorno del stack local (docker compose).
#
# Copia este archivo como .env y cambia los valores:
#   cp .env.example .env
# El .env no se sube a git. Estos valores son ejemplos: sirven para levantar el
# stack en tu máquina, pero no los uses en un entorno compartido.

# --- Bases de datos -----------------------------------------------------------
# Las cinco bases comparten usuario y contraseña. Usa solo letras, números y
# guiones: la contraseña se pasa a comandos de shell en los healthchecks.
DB_USER=cine
DB_PASSWORD=cambia-esta-clave

# --- JWT ----------------------------------------------------------------------
# Clave en Base64 de al menos 32 bytes. Genera la tuya con: openssl rand -base64 48
JWT_SECRET=ZWplbXBsby1zb2xvLXBhcmEtZGVzYXJyb2xsby1sb2NhbC1nZW5lcmEtZWwtdHV5by1jb24tb3BlbnNzbA==
# Duración del token en milisegundos (3600000 = 1 hora).
JWT_EXPIRATION=3600000

# --- Control de acceso entre servicios ----------------------------------------
# GATEWAY_SECRET: lo agrega el gateway a cada petición; los servicios rechazan
#   lo que llegue a /api/** sin él.
# INTERNAL_TOKEN: identifica las llamadas entre servicios; es lo único que abre
#   /internal/**.
# Sin estos dos valores los servicios no arrancan. Genera cada uno con:
#   openssl rand -hex 32
GATEWAY_SECRET=cambia-esto-por-un-valor-aleatorio
INTERNAL_TOKEN=cambia-esto-por-otro-valor-aleatorio

# --- Frontend -----------------------------------------------------------------
# Origen que el gateway acepta por CORS.
FRONTEND_URL=http://localhost:4200

# --- Correo (recuperación de contraseña) --------------------------------------
# Con valores de ejemplo el stack funciona, pero no envía correos.
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-clave-de-aplicacion
# El chequeo de salud del correo está apagado en local. Actívalo solo si pusiste
# credenciales SMTP reales:
# MAIL_HEALTH_ENABLED=true

# --- Cloudinary (subida de imágenes) ------------------------------------------
# Con valores de ejemplo el stack funciona, pero no sube imágenes.
CLOUDINARY_CLOUD_NAME=tu-cloud
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# --- Pruebas de API (tests/api) -----------------------------------------------
# Cliente de prueba. Si no existe, las pruebas lo registran.
TEST_USER_EMAIL=cliente.prueba@example.com
TEST_USER_PASSWORD=Cambia-esta-clave-1
